#include <zephyr/dt-bindings/gpio/gpio.h>

/* Lab 16 reuses this TFT wiring UNCHANGED from Lab 11/12/13/14/15 -- no new
 * hardware. M55's only job in this lab is drawing the combined ENV/MOTION/
 * WATCHDOG/STATUS state on the same ST7789V3 panel on SPI0. */

/* ipc0 shared-memory-size must match the M4 overlay in remote/boards/ exactly. */
&ipc0 {
	shared-memory-size = <0x400>;
};

/*
 * M4/M55 physically share the &i2c1 bus (mc3479, gpio_exp0). M4 owns it in
 * this lab (Motion_Task), so M55 disables it -- same reasoning as every
 * earlier lab since Lab 01.
 */
&i2c1 {
	status = "disabled";
};

&gpio_exp0 {
	status = "disabled";
};

&ov02c10 {
	status = "disabled";
};

/*
 * ST7789V3 1.69" 240x280 color TFT on M55's SPI0 -- identical setup to
 * Lab 11/12/13/14/15 (same panel, same wiring, same raw-SPI "zds,st7789v"
 * custom binding). See Lab 11's doc for the full rationale (why raw SPI
 * instead of Zephyr's in-tree display driver, the level-shifter
 * requirement, the SPI0 FIFO chunking, and the SPI0/UART1 console pin
 * conflict this creates).
 */
&ns16550_uart1 {
	status = "disabled";
};

&spi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spi_mstr_mosi &spi_mstr_miso &spi_mstr_clk &spi_mstr_cs>;
	pinctrl-names = "default";

	st7789v_disp: st7789v@0 {
		compatible = "zds,st7789v";
		reg = <0>;
		spi-max-frequency = <4000000>;
		reset-gpios = <&gpioa 17 GPIO_ACTIVE_LOW>;  /* SoC GPIO17, J24 pin 3 - through level shifter */
		dc-gpios = <&gpioa 18 GPIO_ACTIVE_HIGH>;    /* SoC GPIO18, J24 pin 4 - through level shifter */
		width = <240>;
		height = <280>;
		x-offset = <0>;
		y-offset = <20>;
	};
};
